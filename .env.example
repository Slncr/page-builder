# Local development only. Copy to .env and replace every change-me value.
COMPOSE_PROJECT_NAME=page-builder

# Service ports
FRONTEND_PORT=15173
BACKEND_PORT=18080
POSTGRES_PORT=25432
REDIS_PORT=26379
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
GATEWAY_PORT=18081

# PostgreSQL
POSTGRES_DB=page_builder
POSTGRES_USER=page_builder
POSTGRES_PASSWORD=change-me-local-postgres
PB_DATABASE_URL=postgresql+asyncpg://page_builder:change-me-local-postgres@postgres:5432/page_builder

# Redis
PB_REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible media storage
MINIO_ROOT_USER=page-builder-local
MINIO_ROOT_PASSWORD=change-me-local-minio
S3_BUCKET=page-builder-media
PB_OBJECT_STORAGE=minio
PB_MINIO_ENDPOINT=minio:9000
PB_MINIO_SECURE=false
PB_PUBLIC_ASSET_BASE_URL=/api/v1/public/assets

# Runtime commands. Adjust these only if the owning application uses other entrypoints.
BACKEND_COMMAND=uvicorn app.main:app --host 0.0.0.0 --port 8000
BACKEND_HEALTHCHECK_PATH=/health/ready
FRONTEND_COMMAND=npm run dev -- --host 0.0.0.0 --port 5173
SCHEDULER_COMMAND=python -m app.cli.scheduler
WORKER_COMMAND=python -m app.cli.worker

# Single-language locale contract for backend and Vite.
PB_DEFAULT_LOCALE=ru
VITE_DEFAULT_LOCALE=ru

# Browser-visible and server-side origins
VITE_API_URL=/api/v1
VITE_BASE_PATH=/
VITE_DEV_API_TARGET=http://backend:8000
VITE_DEMO_MODE=false
PB_CORS_ORIGINS=["http://localhost:15173"]

# Rollout contract. Generic FEATURE_* flags require application enforcement.
FEATURE_PAGE_BUILDER=false
FEATURE_SCHEDULER=false
FEATURE_MEDIA_UPLOADS=false
FEATURE_BATCH_PUBLISH=false
LEGACY_ADAPTER_MODE=disabled
PUBLIC_READ_FAIL_CLOSED=true
PB_LEGACY_FALLBACK_ENABLED=false

# Optional legacy-first gateway profile. Core Compose services do not require
# this external network; it is checked only when the gateway profile is started.
PAGE_BUILDER_ROUTE_ENABLED=0
LEGACY_UPSTREAM_HOST=legacy.invalid
LEGACY_UPSTREAM_PORT=80
LEGACY_DOCKER_NETWORK=site_default

# E2E and load-test defaults
E2E_FRONTEND_BASE_URL=http://127.0.0.1:15173
E2E_GATEWAY_BASE_URL=
E2E_API_BASE_URL=http://127.0.0.1:18080
E2E_API_HEALTH_PATH=/health/ready
E2E_PUBLIC_PATH=/
K6_BASE_URL=http://127.0.0.1:18080
K6_FRONTEND_URL=http://127.0.0.1:15173

# Never use these placeholders outside local development.
PB_JWT_SECRET=change-me-local-app-secret-at-least-32-characters
EDITOR_TOKEN=
ADMIN_TOKEN=
