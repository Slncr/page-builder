PB_ENVIRONMENT=local
PB_DEBUG=false
PB_DEFAULT_LOCALE=ru
PB_BUILDER_ENABLED=true
PB_PUBLIC_RENDERER_ENABLED=true
PB_MEDIA_ENABLED=true
PB_BATCH_PUBLISH_ENABLED=true
PB_DATABASE_URL=postgresql+asyncpg://page_builder:page_builder@postgres:5432/page_builder
PB_DATABASE_ECHO=false
PB_AUTO_CREATE_SCHEMA=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PB_JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
PB_JWT_ISSUER=construktor
PB_ACCESS_TOKEN_MINUTES=15
PB_REFRESH_TOKEN_DAYS=30
PB_COOKIE_SECURE=false
PB_COOKIE_SAMESITE=lax
PB_COOKIE_DOMAIN=

PB_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
PB_TRUSTED_HOSTS=["localhost","127.0.0.1"]

PB_REDIS_URL=redis://redis:6379/0
PB_CACHE_PREFIX=page-builder
PB_PUBLIC_CACHE_SECONDS=300

PB_OBJECT_STORAGE=local
PB_LOCAL_STORAGE_PATH=./var/assets
PB_PUBLIC_ASSET_BASE_URL=/api/v1/public/assets
PB_MINIO_ENDPOINT=minio:9000
PB_MINIO_ACCESS_KEY=minioadmin
PB_MINIO_SECRET_KEY=replace-me
PB_MINIO_BUCKET=page-builder
PB_MINIO_SECURE=false
PB_MAX_UPLOAD_BYTES=26214400
PB_MAX_JSON_BODY_BYTES=2097152
PB_EDIT_LOCK_TTL_SECONDS=120
PB_PREVIEW_TOKEN_MINUTES=15
PB_IDEMPOTENCY_TTL_HOURS=24
PB_AUTOSAVE_SNAPSHOT_INTERVAL_SECONDS=300
PB_AUTOSAVE_SNAPSHOT_RETENTION=20
PB_BATCH_PUBLISH_MAX_ITEMS=25
PB_RENDITION_WIDTHS=[320,640,1024,1600,2048]
PB_IMAGE_QUALITY=85
PB_IMAGE_MAX_BYTES=512000
PB_IMAGE_MAX_DIMENSION=2048

PB_SCHEDULER_ENABLED=false
PB_SCHEDULER_INTERVAL_SECONDS=15
PB_WORKER_ENABLED=false
PB_WORKER_INTERVAL_SECONDS=5
PB_CLEANUP_AFTER_DAYS=30
PB_TRASH_RETENTION_DAYS=30
PB_LEGACY_FALLBACK_ENABLED=true
PB_PUBLIC_READ_FAIL_CLOSED=true
PB_EMBED_ALLOWED_HOSTS=["youtube.com","www.youtube.com","youtu.be","player.vimeo.com","vimeo.com","maps.google.com","www.google.com","yandex.com","yandex.ru"]
PB_READINESS_REQUIRE_ALEMBIC_HEAD=true
# PB_CONTENT_SECURITY_POLICY=default-src 'self'; object-src 'none'; base-uri 'self'
PB_FORM_DEFAULT_MIN_ELAPSED_SECONDS=2
PB_FORM_MAX_ELAPSED_HOURS=24
PB_WEBHOOK_ALLOWED_HOSTS=[]
PB_WEBHOOK_ALLOW_HTTP=false
PB_WEBHOOK_TIMEOUT_SECONDS=5
# PB_WEBHOOK_SIGNING_SECRET=replace-with-a-separate-random-secret
